    {
      "parameters": {
        "jsCode": "// Get the raw text from the AI's output\nconst item = $input.first();\n\n// Basic validation\nif (!item.json || !item.json.output || typeof item.json.output !== 'string') {\n  return { json: { error: \"Input is missing or not a string\" } };\n}\nlet rawTextFromAI = item.json.output;\n\n// --- Step 1: Un-escape Newlines ---\nlet processedText = rawTextFromAI.replace(/\\\\n/g, '\\n');\n\n// --- Step 2: Isolate the Core Markdown Content ---\nconst firstHeadingIndex = processedText.search(/^#+\\s/m);\nif (firstHeadingIndex !== -1) {\n  processedText = processedText.substring(firstHeadingIndex);\n} else {\n  const separatorIndex = processedText.indexOf('***');\n  if (separatorIndex !== -1) {\n    processedText = processedText.substring(separatorIndex + 3).trim();\n  }\n}\n\n// --- Step 3: Normalize Paragraph Breaks for Perfect Markdown ---\nprocessedText = processedText.replace(/\\n{3,}/g, '\\n\\n');\n\n// --- Step 4: Final Polishing ---\nprocessedText = processedText.replace(/[ \\t]+\\n/g, '\\n');\nprocessedText = processedText.trim();\n\n// --- CRITICAL ADDITION: Prepare for Binary Output ---\n// Derive a filename from the article's first line (the title)\nconst firstLineOfContent = processedText.split('\\n')[0];\n// Clean up Markdown heading syntax and remove invalid filename characters\nconst fileNameBase = firstLineOfContent.replace(/^(#+\\s*)/, '').trim().substring(0, 100).replace(/[\\\\/:*?\"<>|]/g, ''); // Max 100 chars\nconst fullFileName = `${fileNameBase || 'Untitled Article'}.md`; // Fallback name if title is empty\n\n// Return the item with the content as a binary property\nreturn [{\n  json: {\n    // Optionally keep the text in JSON for debugging or if other nodes need it as a string\n    cleaned_post_text_string: processedText\n  },\n  // This 'binary' object is what the Google Drive node expects\n  binary: {\n    // 'markdownFile' is a key name you choose for this binary property.\n    // It's what you will put in 'Input Data Field Name' in the Google Drive node.\n    markdownFile: {\n      data: Buffer.from(processedText, 'utf8'), // Convert the string to a Node.js Buffer\n      fileName: fullFileName,\n      mimeType: 'text/markdown' // Specify the MIME type\n    }\n  }\n}];"
      },
